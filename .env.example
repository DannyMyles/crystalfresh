# Copy to .env.local for local development, and add the same variables in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# After setting a delivery channel, run `npm run check:delivery` to confirm it works.

# ── Site ──────────────────────────────────────────────────────────────────────
# Public URL once the domain is confirmed (used for canonical URLs, sitemap,
# Open Graph and structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ── Form delivery (configure at least ONE; using both is recommended) ─────────
# Forms show an error, never a fake success, until a channel is configured.

# Option A1: Email via Gmail (or any SMTP server). Simplest option.
# Create an app password: Google Account → Security → 2-Step Verification → App passwords.
# Mail is sent from this Gmail address, and customers also receive a receipt.
SMTP_USER=
SMTP_PASSWORD=
# Defaults to Gmail (smtp.gmail.com, port 465). Change only for another provider.
SMTP_HOST=
SMTP_PORT=

# Option A2: Email via Resend (https://resend.com). Ignored when SMTP_USER is set.
RESEND_API_KEY=
# Where submissions are sent (comma-separate for several). Defaults to the business email.
INQUIRY_TO_EMAIL=muhadiwawire@gmail.com
# Sender. Must use a domain verified in Resend. Until then, leave empty: the test
# sender onboarding@resend.dev is used, which only delivers to the email address
# of the Resend account owner.
INQUIRY_FROM_EMAIL=
# Customers who give an email get a short receipt with their reference number,
# once INQUIRY_FROM_EMAIL uses a verified domain. Set to "false" to turn this off.
SEND_CUSTOMER_CONFIRMATION=

# Option B: Webhook. Receives a JSON POST of each submission.
# For a Google Sheets log, see integrations/google-sheets/README.md and use:
#   FORM_WEBHOOK_URL=https://script.google.com/macros/s/…/exec?secret=…
FORM_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header (not needed for Google Sheets).
FORM_WEBHOOK_SECRET=

# ── Spam protection ───────────────────────────────────────────────────────────
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Set both. Recommended.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared rate limit across all server instances (recommended on Vercel).
# Create a free Upstash Redis database (or add Upstash from the Vercel Marketplace,
# which sets KV_REST_API_URL / KV_REST_API_TOKEN automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Valid submissions allowed per visitor every 10 minutes (default 5).
FORM_RATE_LIMIT_MAX=

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Tracks page views, call /
# WhatsApp / email clicks and form submissions (never form contents).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Delivery check script only ────────────────────────────────────────────────
# An address of yours, so `npm run check:delivery` also tests the customer receipt.
CHECK_DELIVERY_REPLY_TO=
