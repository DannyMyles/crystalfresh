{
  "name": "crystal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_GA_MEASUREMENT_ID=G-E2ETEST000 next build && playwright test",
    "test:all": "npm run lint && npm test && npm run test:e2e",
    "check:delivery": "tsx --conditions=react-server scripts/check-delivery.ts"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.28",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "nodemailer": "^10.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
